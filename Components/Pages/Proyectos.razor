@page "/proyectos"
@page "/proyectos/{filtro}"

<PageTitle>Proyectos — Portfolio</PageTitle>

<div class="page">
    <PageBanner Title="Proyectos" Subtitle="Trabajos recientes con stack, demo y repositorio." />

    <section class="section section-tight">
        <div class="container">
            <ProjectsGrid Filtro="@Filtro" />
        </div>
    </section>
</div>

@code {
    // Parámetro de ruta tipado: /proyectos/frontend, /proyectos/blazor, etc.
    [Parameter] public string? Filtro { get; set; }
}
